# Here we set a bunch of parameters for your image build

# output image name, usually same as repo name, change as needed
IMAGE_NAME=jupiter-bootc

# Make this the same as your github username/organisation
REPO_ORGANIZATION="Gasterboi2012"

IMAGE_DESC="Jupiter: NVIDIA-only atomic KDE Plasma desktop"
IMAGE_KEYWORDS="bootc,oci,linux,kde,plasma,nvidia"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://raw.githubusercontent.com/Gasterboi2012/jupiter-bootc/main/system_files/usr/share/jupiter/branding/jupiter-logo.svg"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
